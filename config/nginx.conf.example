server {
    listen 80;
    server_name psn.example.test;
    return 301 https://$host$request_uri;
}

upstream psn_add_pool {
    least_conn;
    server 127.0.0.1:8890 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

server {
    listen 443 ssl;
    server_name psn.example.test;

    ssl_certificate     /etc/letsencrypt/live/psn.example.test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/psn.example.test/privkey.pem;

    access_log /var/log/nginx/psn-add.access.log;
    error_log  /var/log/nginx/psn-add.error.log;

    client_max_body_size 1m;

    location / {
        proxy_pass http://psn_add_pool;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }
}
