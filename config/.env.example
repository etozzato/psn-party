NAME=PSN Add
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8890
PORT=8890
BIND_ADDRESS=127.0.0.1
LOG_LEVEL=info
CORS_ALLOW_ORIGIN=*

POSTGRES_DB=psn_add
POSTGRES_USER=psn_add
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://psn_add:change-me@127.0.0.1:5432/psn_add?sslmode=disable

DB_MAX_CONNS=15
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE_SECONDS=120
DB_MAX_CONN_LIFETIME_SECONDS=1800
PROFILE_TIMEOUT_SECONDS=4

# Production Docker/Nginx helpers.
DOMAIN=psn.example.test
DOMAINS=psn.example.test
CERT_NAME=psn.example.test
HOST_PORT=8890
PSN_ADD_POOL=1
